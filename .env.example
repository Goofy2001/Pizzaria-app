# Database Configuration (Supabase)
PGHOST=your-project.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-supabase-password
PGDATABASE=postgres

# Backend Configuration
NODE_ENV=production
PORT=8000
FRONT_LOGIN_PASSWORD=your-secure-password
DRIVER_LOGIN_PASSWORD=your-secure-password
INTERNAL_API_KEY=your-secure-api-key
CORS_ORIGIN=https://yourdomain.be,http://localhost
RATE_LIMIT_MAX=300

# Frontend Configuration
VITE_API_URL=https://yourdomain.be:8000
